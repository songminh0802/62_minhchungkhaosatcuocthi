{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "admin"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
